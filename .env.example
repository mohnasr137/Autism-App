# ==============================================================================
# Autismo API - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3000
API_URL=/api/v1

# Database Configuration
CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret
SECRET=your_jwt_super_secret_key_change_me_in_production

# Email / SMTP Configuration (Nodemailer for Gmail)
USER=your_email@gmail.com
PASSWORD=your_gmail_app_password

# External APIs
# YouTube Data API v3 Key (for video recommendations & channel data)
API_KEY=your_youtube_data_api_key

# SerpAPI Key (for scraping online autism resources & articles)
SERPAPI_KEY=your_serpapi_api_key

# Google Gemini Generative AI API Key (for post classification & AI assistance)
GENERATIVE_AI_API_KEY=your_gemini_api_key

# APILayer Text Moderation API Key (for content screening on comments)
MODERATION_KEY=your_apilayer_moderation_key

# Machine Learning Service Configuration (Flask/FastAPI microservice for tests)
ML_API_URL=http://localhost:5000

# Ngrok Tunnel Configuration (Optional, set ENABLE_NGROK=true to expose server)
ENABLE_NGROK=false
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
